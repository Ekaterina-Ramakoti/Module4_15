  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=40><b>\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440:</b></size>\n\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u0438 \u043E\u0437\u043E\u0440\u043D\u043E\u0439.\n\n<size=40><b>\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435:</b></size>\n\u0420\u044B\u0436\u0438\u043A
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0443\u0441\u0438\u0434\u0435\u0442\u044C
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u043D\u0438 \u043C\u0438\u043D\u0443\u0442\u044B.
    \u041E\u043D \u043E\u0431\u043E\u0436\u0430\u0435\u0442 \u0431\u0435\u0433\u0430\u0442\u044C,
    \u043F\u0440\u044B\u0433\u0430\u0442\u044C, \u043B\u0430\u0437\u0438\u0442\u044C
    \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C \u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0448\u0430\u043B\u043E\u0441\u0442\u0438.
    \u0414\u043B\u044F \u043D\u0435\u0433\u043E \u043E\u0431\u044B\u0447\u043D\u0430\u044F
    \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0430 \u2014 \u044D\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435, \u0430 \u043B\u044E\u0431\u043E\u0439
    \u0434\u0432\u043E\u0440 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E \u0438\u0433\u0440\u043E\u0432\u0443\u044E
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443."
