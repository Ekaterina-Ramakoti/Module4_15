  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=40><b>A Day in the Life of a Cat</b></size> \u2014 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0447\u0435\u0441\u043A\u0430\u044F
    \u0438\u0433\u0440\u0430 \u043E \u0436\u0438\u0437\u043D\u0438 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
    \u043A\u043E\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443 \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0439 \u043C\u0438\u0440.\n\n\u0418\u0433\u0440\u043E\u043A\u0443
    \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043E\u0442\u0430 \u0438 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0441 \u043D\u0438\u043C \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C:
    \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0434\u043E\u043C\u0430, \u043F\u043E\u0433\u0443\u043B\u044F\u0442\u044C
    \u043F\u043E \u0434\u0432\u043E\u0440\u0443, \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430,
    \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438,
    \u043D\u0430\u0439\u0442\u0438 \u0432\u043A\u0443\u0441\u043D\u043E\u0435 \u0443\u0433\u043E\u0449\u0435\u043D\u0438\u0435
    \u0438, \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435, \u043D\u0435\u043C\u043D\u043E\u0433\u043E
    \u043F\u043E\u0445\u0443\u043B\u0438\u0433\u0430\u043D\u0438\u0442\u044C.\n\n\u0423
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043A\u043E\u0442\u0430 \u0441\u0432\u043E\u0439
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0438 \u0441\u0432\u043E\u0438
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0434\u0435\u043D\u044C
    \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0439\u0442\u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
    \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443!"
