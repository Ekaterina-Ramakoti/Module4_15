  m_text: "<size=40><b>\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440:</b></size>\n\u043B\u0435\u043D\u0438\u0432\u044B\u0439
    \u0438 \u0445\u0438\u0442\u0440\u044B\u0439.\n\n<size=40><b>\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435:</b></size>\n\u041C\u0443\u0440\u0437\u0438\u043A
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
    \u0434\u0435\u043D\u044C \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u044C
    \u0438\u0437 \u0441\u043D\u0430, \u0432\u043A\u0443\u0441\u043D\u043E\u0439 \u0435\u0434\u044B
    \u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439.
    \u041D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441
    \u0438\u043B\u0438 \u0437\u0430\u043F\u0430\u0445 \u0447\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0432\u043A\u0443\u0441\u043D\u043E\u0433\u043E \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0435\u0433\u043E \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043B\u044E\u0431\u0438\u043C\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E \u043D\u0430 \u0434\u0438\u0432\u0430\u043D\u0435.
    \u041C\u0443\u0440\u0437\u0438\u043A \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0451\u0442
    \u0441\u043F\u043E\u0441\u043E\u0431 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0435, \u043D\u0435 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F
    \u043B\u0438\u0448\u043D\u0438\u0445 \u0443\u0441\u0438\u043B\u0438\u0439."
